POSTGRES_DB=bingo
POSTGRES_USER=bingo_app
POSTGRES_PASSWORD=cambiar_esta_clave
DATABASE_URL=postgresql://bingo_app:cambiar_esta_clave@localhost:5432/bingo?schema=public
# Opcional en producción: conexión directa utilizada solo por Prisma Migrate.
# Si se omite, las migraciones utilizan DATABASE_URL.
DATABASE_DIRECT_URL=

# URL publica definitiva, sin ruta. En Railway use https://su-dominio.example
# Esta variable prevalece sobre una URL guardada previamente en la administracion.
PUBLIC_APP_URL=http://127.0.0.1:3000
# Clave privada estable para cifrar credenciales almacenadas en PostgreSQL.
# Use al menos 32 caracteres aleatorios y no la cambie sin rotar los secretos.
APP_ENCRYPTION_KEY=

# Variables temporales para crear el primer administrador. Elimine
# ADMIN_PASSWORD de Railway inmediatamente después de ejecutar admin:create.
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_PASSWORD=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_PLAYER_ACCESS=player_access
WHATSAPP_TEMPLATE_CARD_ASSIGNMENT=card_assignment
WHATSAPP_TEMPLATE_WINNER_PLAYER=winner_player
WHATSAPP_TEMPLATE_WINNER_GROUP=winner_group
WHATSAPP_GROUP_ID=
WHATSAPP_FUND_CONTACTS=
