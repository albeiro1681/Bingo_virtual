{
  "name": "bingo-virtual",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspace api && npm run build --workspace web",
    "dev:api": "npm run start:dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "lint": "npm run lint --workspace api && npm run lint --workspace web",
    "test": "npm run test --workspace api",
    "start": "npm run start:prod --workspace api"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
