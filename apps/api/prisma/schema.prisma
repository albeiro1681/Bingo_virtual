generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PLAYER
}

enum GameStatus {
  DRAFT
  ACTIVE
  TIE_BREAK
  FINISHED
  CANCELLED
}

enum WinnerType {
  ROW
  COLUMN
  DIAGONAL
  FOUR_CORNERS
  FULL_CARD
  CUSTOM
}

enum WhatsAppDeliveryKind {
  PLAYER_ACCESS
  CARD_ASSIGNMENT
  WINNER_PLAYER
  WINNER_GROUP
  WINNER_CONTACT
}

enum WhatsAppDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model BingoPattern {
  id        String             @id @default(cuid())
  name      String             @unique
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  cells     BingoPatternCell[]
  games     Game[]
}

model BingoPatternCell {
  id        String       @id @default(cuid())
  patternId String
  row       Int
  column    Int
  pattern   BingoPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, row, column])
}

model User {
  id                 String             @id @default(cuid())
  name               String
  role               UserRole           @default(PLAYER)
  tokenHash          String             @unique
  tokenEncrypted     String?
  username           String?            @unique
  passwordHash       String?
  phone              String?            @unique
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cards              Card[]
  winners            Winner[]
  whatsappDeliveries WhatsAppDelivery[]
  adminSessions      AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WhatsAppSettings {
  id                     Int      @id @default(1)
  accessTokenEncrypted   String?
  phoneNumberId          String?
  businessAccountId      String?
  graphApiVersion        String   @default("v23.0")
  templateLanguage       String   @default("es")
  playerAccessTemplate   String   @default("player_access")
  cardAssignmentTemplate String   @default("card_assignment")
  winnerPlayerTemplate   String   @default("winner_player")
  winnerFundTemplate     String   @default("winner_group")
  fundContacts           String?
  publicAppUrl           String?
  updatedAt              DateTime @updatedAt
}

model CardAssignmentAudit {
  id             String   @id @default(cuid())
  cardId         String
  cardNumber     Int
  previousUserId String?
  newUserId      String?
  action         String
  createdAt      DateTime @default(now())

  @@index([cardId])
  @@index([createdAt])
}

model Game {
  id                  String              @id @default(cuid())
  name                String
  status              GameStatus          @default(DRAFT)
  winningType         WinnerType          @default(FULL_CARD)
  patternId           String?
  patternName         String?
  startedAt           DateTime?
  finishedAt          DateTime?
  endedManually       Boolean             @default(false)
  finalWinnerId       String?
  tieBreakCompletedAt DateTime?
  prizeAmount         Decimal?            @db.Decimal(18, 0)
  currencyCode        String              @default("COP")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  drawnBalls          DrawnBall[]
  winners             Winner[]
  finalWinner         Card?               @relation("FinalWinner", fields: [finalWinnerId], references: [id], onDelete: Restrict)
  tieBreakCandidates  TieBreakCandidate[]
  pattern             BingoPattern?       @relation(fields: [patternId], references: [id], onDelete: Restrict)
  winningCells        GameWinningCell[]
  whatsappDeliveries  WhatsAppDelivery[]

  @@index([patternId])
  @@index([finalWinnerId])
}

model GameWinningCell {
  id     String @id @default(cuid())
  gameId String
  row    Int
  column Int
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, row, column])
}

model Card {
  id                 String              @id @default(cuid())
  serial             String              @unique
  userId             String
  templateId         String              @unique
  number             Int                 @unique
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  template           CardTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  cells              CardCell[]
  winners            Winner[]
  gamesWon           Game[]              @relation("FinalWinner")
  tieBreakCandidates TieBreakCandidate[]

  @@index([userId])
}

model CardTemplate {
  id        String             @id @default(cuid())
  number    Int                @unique
  createdAt DateTime           @default(now())
  cells     CardTemplateCell[]
  card      Card?
}

model CardTemplateCell {
  id         String       @id @default(cuid())
  templateId String
  row        Int
  column     Int
  number     Int?
  isFree     Boolean      @default(false)
  template   CardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, row, column])
  @@unique([templateId, number])
}

model CardCell {
  id     String  @id @default(cuid())
  cardId String
  row    Int
  column Int
  number Int?
  isFree Boolean @default(false)
  card   Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, row, column])
  @@unique([cardId, number])
  @@index([number])
}

model DrawnBall {
  id        String   @id @default(cuid())
  gameId    String
  number    Int
  drawOrder Int
  drawnAt   DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@unique([gameId, number])
  @@unique([gameId, drawOrder])
}

model Winner {
  id                 String             @id @default(cuid())
  gameId             String
  cardId             String
  playerId           String
  type               WinnerType
  prizeAmount        Decimal?           @db.Decimal(18, 0)
  currencyCode       String             @default("COP")
  winningBallNumber  Int?
  isFinal            Boolean            @default(true)
  detectedAt         DateTime           @default(now())
  game               Game               @relation(fields: [gameId], references: [id], onDelete: Restrict)
  card               Card               @relation(fields: [cardId], references: [id], onDelete: Restrict)
  player             User               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  whatsappDeliveries WhatsAppDelivery[]

  @@unique([gameId, cardId, type])
  @@index([gameId])
  @@index([playerId])
  @@index([cardId])
  @@index([detectedAt])
}

model TieBreakCandidate {
  id        String   @id @default(cuid())
  gameId    String
  cardId    String
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([gameId, cardId])
  @@index([gameId])
  @@index([cardId])
}

model WhatsAppDelivery {
  id                String                 @id @default(cuid())
  kind              WhatsAppDeliveryKind
  status            WhatsAppDeliveryStatus @default(PENDING)
  recipient         String
  templateName      String
  payload           Json
  idempotencyKey    String                 @unique
  providerMessageId String?
  error             String?
  attempts          Int                    @default(0)
  userId            String?
  gameId            String?
  winnerId          String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  game              Game?                  @relation(fields: [gameId], references: [id], onDelete: Restrict)
  winner            Winner?                @relation(fields: [winnerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([userId])
  @@index([gameId])
  @@index([winnerId])
}
